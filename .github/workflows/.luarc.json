{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": true
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME/lua",
      "$PWD/lua",
      "$PWD/deps/snacks.nvim/lua",
      "$PWD/deps/plenary.nvim/lua",
      "$PWD/deps/telescope.nvim/lua",
      "$PWD/deps/fzf-lua/lua",
      "$PWD/deps/nvim-web-devicons/lua"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "severity": {
      "await-in-sync": "Error",
      "no-unknown": "Warning",
      "deprecated": "Warning",
      "unused-local": "Error",
      "unused-function": "Error",
      "undefined-field": "Error",
      "assign-type-mismatch": "Error",
      "duplicate-doc-field": "Hint",
      "duplicate-doc-alias": "Hint",
      "duplicate-set-field": "Hint"
    },
    "neededFileStatus": {
      "await-in-sync": "Any",
      "no-unknown": "Any",
      "deprecated": "Any"
    },
    "unusedLocalExclude": [
      "_*"
    ]
  }
}
